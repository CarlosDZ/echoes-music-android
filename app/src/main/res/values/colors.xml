<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Echoes brand palette — dark only. Hex defined once here; mapped to
         Material3 color roles in themes.xml so widgets pick them up automatically. -->

    <!-- Backgrounds and surfaces -->
    <color name="echoes_background">#121212</color>
    <color name="echoes_surface">#1E1E1E</color>
    <color name="echoes_surface_variant">#2A2A2A</color>
    <color name="echoes_outline">#3A3A3A</color>

    <!-- Purple accent -->
    <color name="echoes_primary">#B14EFF</color>
    <color name="echoes_on_primary">#000000</color>
    <color name="echoes_primary_container">#4A2A7A</color>
    <color name="echoes_on_primary_container">#E0CFFF</color>

    <!-- Text / foreground -->
    <color name="echoes_on_background">#FFFFFF</color>
    <color name="echoes_on_surface">#FFFFFF</color>
    <color name="echoes_on_surface_variant">#B3B3B3</color>

    <!-- Status feedback -->
    <color name="echoes_success">#66BB6A</color>
    <color name="echoes_error">#CF6679</color>
</resources>
